# Copy to .env and fill in. Never commit the real .env file.

# --- Runtime ---
ENV=development                   # development | production -- production enforces strict validation below

# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=roviq_ai

# --- PostgreSQL (for PgBouncer connection pooling) ---
# Optional: Use Render's pooled connection URL for better scalability
POSTGRES_URL=postgresql://user:password@host:5432/dbname
# Or use PgBouncer pooled connection (recommended for Render):
# POSTGRES_URL=postgresql://user:password@host:6543/dbname?sslmode=require

# --- Auth ---
JWT_SECRET=                       # required. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_EMAIL=                      # optional but recommended -- the ONLY way an account becomes admin
ADMIN_PASSWORD=                   # required if ADMIN_EMAIL is set; 10+ characters in production

# --- CORS ---
# Comma-separated list of exact origins allowed to call this API with credentials.
# Required (no wildcard) in production.
CORS_ORIGINS=http://localhost:3000

# --- Gemini (LLM) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Used for hybrid semantic search (retrieval.py + embeddings.py). Optional -- if unset or
# wrong, embedding calls fail closed and search falls back to BM25-only automatically.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Object storage (S3-compatible) ---
# Leave all blank to fall back to local disk (fine for a single-instance dev/self-host
# setup, but files won't survive a redeploy on most PaaS hosts). Cloudflare R2's free
# tier (10GB storage, no egress fees) is a good lowest-cost production option --
# S3_ENDPOINT_URL looks like https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
S3_PUBLIC_URL=

# --- Razorpay (domestic/INR payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=          # set after creating the webhook in the Razorpay dashboard

# --- Outbound email (HTTP API providers preferred) ---
# Primary: Resend HTTP API (free tier: 3k/month, no credit card needed)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Roviq Ai

# Alternative: Brevo (Sendinblue) HTTP API (free tier: 300/day)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Roviq Ai

# Fallback: SMTP (works with any provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Roviq Ai
SMTP_USE_TLS=true

# --- Rate limiting & Caching ---
# Redis is now used for:
# - Distributed rate limiting across multiple backend instances
# - Business rules cache (FAQs, AI instructions, working hours)
# - Conversation history cache (last 50 messages per session)
# - AI response cache (deterministic questions)
# - Spam detection scores
# - Background job queues (RQ)
REDIS_URL=redis://localhost:6379/0

# --- Google OAuth ("Continue with Google") ---
# Optional -- requires an OAuth client from Google Cloud Console, see DEPLOYMENT.md.
# Leave blank to simply not offer Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Cloudflare Turnstile (CAPTCHA alternative) ---
# Free, privacy-friendly CAPTCHA that triggers only for suspicious activity
# Get keys at: https://www.cloudflare.com/products/turnstile/
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Scheduled jobs (weekly re-crawl + staleness nudges) ---
# Set to false on all but one replica if running multiple backend instances.
ENABLE_SCHEDULER=true

# --- Misc ---
APP_NAME=roviq-ai
FRONTEND_URL=http://localhost:3000
