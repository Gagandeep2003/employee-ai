```gitignore
# Dependencies
node_modules/

# Build artifacts
build/
dist/
*.js.map

# Editors
.vscode/
.idea/

# Environment
.env
.env.local
*.env.*

# Logs and temp files
*.log
*.tmp
*.swp

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled files
*.o
*.obj
*.so
*.dll
*.exe

# Coverage
coverage/
htmlcov/
.coverage

# OS
.DS_Store
Thumbs.db
```
